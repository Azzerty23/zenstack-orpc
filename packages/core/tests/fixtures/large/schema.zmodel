// 40 chained models with many-to-many tags, to check that types stay within TypeScript limits.

datasource db {
  provider = 'sqlite'
}

model M0 {
  id        String   @id @default(cuid())
  f0        String
  f1        Int
  f2        Boolean
  f3        DateTime
  f4        Float
  f5        String?
  f6        Int?
  f7        Json?
  createdAt DateTime @default(now())
  children  M1[]
  tags      Tag[]
}

model M1 {
  id        String   @id @default(cuid())
  f0        String
  f1        Int
  f2        Boolean
  f3        DateTime
  f4        Float
  f5        String?
  f6        Int?
  f7        Json?
  createdAt DateTime @default(now())
  parent    M0    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  parentId  String
  children  M2[]
  tags      Tag[]
}

